<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Instructor.master.cs" Inherits="EduLearn.Instructor.InstructorMaster" %>

<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EduLearn - Giảng viên</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/Content/CSS/Instructor.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar">
            <div>
                <div class="logo">
                    <span class="logo__icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>
                    </span>
                    <span class="logo__text">EduLearn</span>
                </div>

                <nav class="nav">
                    <a id="navDashboard" runat="server" href="~/Instructor/Dashboard.aspx">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        Tổng quan
                    </a>
                    <a id="navCourses" runat="server" href="~/Instructor/Courses.aspx">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        Môn học của tôi
                    </a>
                    <a id="navLectures" runat="server" href="~/Instructor/Lectures.aspx">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                        Quản lý bài giảng
                    </a>
                    <a id="navNotifications" runat="server" href="~/Instructor/Notifications.aspx">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                        Thông báo
                        <i id="sideDot" runat="server" class="dot" visible="false"></i>
                    </a>
                    <a id="navProfile" runat="server" href="~/Instructor/Profile.aspx">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Hồ sơ cá nhân
                    </a>
                </nav>
            </div>

            <div class="side-user">
                <div class="side-user__box">
                    <span class="avatar"><asp:Literal ID="litSideInitial" runat="server" Mode="Encode" /></span>
                    <span class="side-user__info">
                        <strong><asp:Literal ID="litSideName" runat="server" Mode="Encode" /></strong>
                        <small>Giảng viên</small>
                    </span>
                </div>
            </div>
        </aside>

        <!-- ================= TOPBAR ================= -->
        <header class="topbar">
            <div class="topbar__title">
                <asp:ContentPlaceHolder ID="cphTitle" runat="server">Tổng quan giảng viên</asp:ContentPlaceHolder>
            </div>

            <div class="topbar__right">
                <!-- Enter: chuyển sang trang Môn học kèm từ khóa tìm kiếm -->
                <div class="search">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" placeholder="Tìm kiếm môn học, bài giảng..."
                           onkeydown="if(event.key==='Enter'){event.preventDefault();window.location='<%= ResolveUrl("~/Instructor/Courses.aspx") %>?q='+encodeURIComponent(this.value);}" />
                </div>

                <a class="bell" href="<%= ResolveUrl("~/Instructor/Notifications.aspx") %>" aria-label="Thông báo">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                    <i id="bellDot" runat="server" class="dot" visible="false"></i>
                </a>

                <a class="user-chip" href="<%= ResolveUrl("~/Instructor/Profile.aspx") %>">
                    <span class="avatar"><asp:Literal ID="litTopInitial" runat="server" Mode="Encode" /></span>
                    <span class="user-chip__info">
                        <strong><asp:Literal ID="litTopName" runat="server" Mode="Encode" /></strong>
                        <small>Giảng viên</small>
                    </span>
                </a>

                <asp:LinkButton ID="btnLogout" runat="server" CssClass="logout" OnClick="btnLogout_Click" CausesValidation="false" ToolTip="Đăng xuất">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </asp:LinkButton>
            </div>
        </header>

        <!-- ================= NỘI DUNG TỪNG TRANG ================= -->
        <main class="main">
            <div class="container">
                <asp:ContentPlaceHolder ID="cphMain" runat="server"></asp:ContentPlaceHolder>
            </div>
        </main>
    </form>
</body>
</html>
